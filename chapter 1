
#include <iostream>
using namespace std;

int main() {
    int arr[] = {5, 2, 4, 6, 1, 3};
    int n = 6;

    int comparisons = 0;
    int shifts = 0;

    for (int i = 1; i < n; i++) {
        int key = arr[i];
        int j = i - 1;

        while (j >= 0) {
            comparisons++;

            if (arr[j] > key) {
                arr[j + 1] = arr[j];
                shifts++;
                j--;
            } else {
                break;
            }
        }

        arr[j + 1] = key;
    }

    cout << "Sorted array: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }

    cout << "\nComparisons: " << comparisons;
    cout << "\nShifts: " << shifts;

    return 0;
}
